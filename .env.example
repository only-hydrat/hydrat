# Базовый каталог для данных, базы SQLite и ключей (по умолчанию ./data)
DATA_DIR=./data

# Внешний UDP-порт WireGuard (по умолчанию 51820)
WIREGUARD_PORT=51820

# Порт веб-панели управления на хосте (по умолчанию 8088)
PORTAL_PORT=8088

# Публичный адрес и порт сервера WireGuard для подключения клиентов (IP или домен)
# Пример: 203.0.113.10:51820 или vpn.example.com:51820
WIREGUARD_ENDPOINT=

# Пароль администратора для входа в веб-панель управления (задайте надёжный пароль)
HYDRAT_ADMIN_PASSWORD=

# Опционально: Hardware ID (HWID) приложения Happ для подписок, требующих верификацию клиента
# HYDRAT_HWID=

# Опционально: срок хранения структурированных логов сервисов (по умолчанию 72h)
# HYDRAT_LOG_RETENTION=72h
