# Базовый каталог для данных, базы SQLite и ключей (по умолчанию ./data)
DATA_DIR=./data

# Внешний UDP-порт WireGuard (по умолчанию 51820)
WIREGUARD_PORT=51820

# Веб-панель по умолчанию доступна только с localhost. Не задавайте 0.0.0.0
# без HTTPS reverse proxy с аутентификацией; внутри VPN используйте 10.44.0.1.
PORTAL_BIND_ADDRESS=127.0.0.1

# Порт веб-панели управления на хосте (по умолчанию 8088)
PORTAL_PORT=8088

# Публичный адрес WireGuard (IP или домен); без :port используется WIREGUARD_PORT.
# Пример: 203.0.113.10, 203.0.113.10:51820 или vpn.example.com:51820
WIREGUARD_ENDPOINT=

# Пароль администратора для входа в веб-панель управления (задайте надёжный пароль)
HYDRAT_ADMIN_PASSWORD=

# Опционально: Hardware ID (HWID) приложения Happ для подписок, требующих верификацию клиента
# HYDRAT_HWID=

# Опционально: срок хранения структурированных логов сервисов (по умолчанию 72h)
# HYDRAT_LOG_RETENTION=72h

# Опционально: образ контейнеров Hydrat (по умолчанию ghcr.io/only-hydrat/hydrat:1.0.7)
# HYDRAT_IMAGE=ghcr.io/only-hydrat/hydrat:1.0.7
