+++ b/app/router/hydrat_cancellation_test.go
@@ -0,0 +1,37 @@
+package router
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/xtls/xray-core/common/net"
+)
+
+func TestCanceledReloadAfterLockKeepsInstalledRules(t *testing.T) {
+	rule := func(tag string) *Config {
+		return &Config{Rule: []*RoutingRule{{
+			RuleTag: tag, TargetTag: &RoutingRule_Tag{Tag: tag},
+			Networks: []net.Network{net.Network_TCP},
+		}}}
+	}
+	r := new(Router)
+	if err := r.Init(t.Context(), rule("installed"), nil, nil, nil); err != nil {
+		t.Fatal(err)
+	}
+
+	r.mu.Lock()
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { done <- r.reloadRules(ctx, rule("expired"), false) }()
+	cancel()
+	r.mu.Unlock()
+	if err := <-done; !errors.Is(err, context.Canceled) {
+		t.Fatalf("expired reload returned %v", err)
+	}
+	got := r.ListRule()
+	if len(got) != 1 || got[0].GetRuleTag() != "installed" {
+		t.Fatalf("expired reload changed the installed rules: %+v", got)
+	}
+}
