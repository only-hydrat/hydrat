@@ -0,0 +1,39 @@
+package command
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/xtls/xray-core/app/router"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/serial"
+)
+
+func TestCanceledAddRuleKeepsInstalledRules(t *testing.T) {
+	rule := func(tag string) *router.Config {
+		return &router.Config{Rule: []*router.RoutingRule{{
+			RuleTag: tag, TargetTag: &router.RoutingRule_Tag{Tag: tag},
+			Networks: []net.Network{net.Network_TCP},
+		}}}
+	}
+	r := new(router.Router)
+	if err := r.Init(t.Context(), rule("installed"), nil, nil, nil); err != nil {
+		t.Fatal(err)
+	}
+	s := &routingServer{router: r}
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	_, err := s.AddRule(ctx, &AddRuleRequest{Config: serial.ToTypedMessage(rule("expired"))})
+	got := r.ListRule()
+	if !errors.Is(err, context.Canceled) || len(got) != 1 || got[0].GetRuleTag() != "installed" {
+		t.Fatalf("canceled update changed routing: err=%v, rules=%+v", err, got)
+	}
+	if _, err := s.AddRule(t.Context(), &AddRuleRequest{Config: serial.ToTypedMessage(rule("current"))}); err != nil {
+		t.Fatal(err)
+	}
+	got = r.ListRule()
+	if len(got) != 1 || got[0].GetRuleTag() != "current" {
+		t.Fatalf("current update was not applied: %+v", got)
+	}
+}
